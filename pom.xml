<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.cloudinary.test</groupId>
  <artifactId>webapp</artifactId>
  <version>1.0</version>
  <name>Mailgun API Test</name>  
  <description>A simple app to connect and request mail preview using Mailgun SDK.</description>

  <!-- I keep getting a source encoding warning.. Using platform encoding (UTF-8 actually) to copy filtered resources, i.e. build is platform dependent!-->
  <!-- fixing it based on the suggestion https://stackoverflow.com/questions/24144073/why-does-maven-warn-me-about-encoding-->
  <!-- Make sure the folder structure is as per this document: https://maven.apache.org/guides/introduction/introduction-to-the-standard-directory-layout.html -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <!-- now add packages-->
  <dependencies>
    
    <!-- JUnit for testing-->
    <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>4.13</version>
        <scope>test</scope>
    </dependency>

    <!-- Jackson for JSON serialization and deserialization-->
    <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.18.1</version>
        <scope>test</scope>
    </dependency>

 <!-- when i built the first unit test, it failed as it required Jupiter-->
        <!-- https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-api -->
<dependency>
    <groupId>org.junit.jupiter</groupId>
    <artifactId>junit-jupiter-api</artifactId>
    <version>5.11.4</version>
    <scope>test</scope>
</dependency>
  </dependencies>

  <!-- build related details-->
  <build>
    <plugins>
     <!-- Maven Test Plugin for running tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <includes>
                        <!-- set this to the correct test file-->
                        <include>com.cloudinary.test.HelloTest.class</include>
                    </includes>
                </configuration>
            </plugin>
        <!-- Maven Jar Plugin for creating the final JAR file -->
        <!-- when I did not include this, I got a JAR file that was empty-->
        <!-- Maven threw this warning.. [WARNING] JAR will be empty - no content was marked for inclusion!-->
        <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <mainClass>com.cloudinary.test</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

        <!-- turns out nothing was even compiled. We need to add a maven compiler for ensuring the code is actually compiled -->
         <!-- Maven Compiler Plugin for Java version -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>23</source>
                    <target>23</target>
                </configuration>
            </plugin>

       

    </plugins>
  </build>
</project>
